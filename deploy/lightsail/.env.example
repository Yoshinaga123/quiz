# Copy to .env on the Lightsail host. Never commit .env.
# Replace PUBLIC_IP with the Lightsail static IP (e.g. 54.x.x.x).

PUBLIC_IP=YOUR.STATIC.IP.HERE

# Built into the web SPA at image build time — must match the URL you open in the browser
VITE_API_BASE_URL=https://${PUBLIC_IP}
CORS_ALLOWED_ORIGINS=https://${PUBLIC_IP}

# PostgreSQL (Compose-internal; do not publish 5432)
DB_USER=quiz
DB_PASSWORD=change-me-db-password
DB_NAME=quiz

# Kept for the API binary; /api is not exposed on the public Caddy preview
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password
JWT_SECRET=change-me-long-random-secret
