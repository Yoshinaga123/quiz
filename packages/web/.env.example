# 公開クイズアプリ用の環境変数テンプレート
# 12-Factor App に従い、実値は .env.local や CI/CD のシークレットに置くこと。

# 公開 API のベース URL。未設定の場合は src/data/quizzes.ts のスターターパックを利用する。
# 例: http://localhost:8082（開発）, https://socrates-quiz.jp（本番・HTTPS 443）
VITE_API_BASE_URL=

# 任意。リリースバージョン表示用（未設定なら表示しない）。
VITE_APP_VERSION=

# 任意。アクセス解析タグの ID（未設定なら無効化）。
VITE_ANALYTICS_ID=
