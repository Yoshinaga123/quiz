# Backend API 用の環境変数テンプレート
# 12-Factor App に従い、実値は .env や CI/CD のシークレットに置くこと。
#
# Go は .env を自動読み込みしない。ローカルで `go run .` する前に export する。
#   set -a && source .env && set +a && go run .
#
# または `python3 ../scripts/create_backend_env.py` で対話的に .env を生成できる。
# Docker Compose 利用時は docker-compose.yml の environment が優先される。

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=counter

# 管理者認証（開発用の既定値。本番では必ず変更する）
ADMIN_USER=admin
ADMIN_PASSWORD=password
JWT_SECRET=dev-only-secret

# 会員認証（ADR 0016）。admin と鍵を共有しないこと。本番では必ず変更する。
MEMBER_JWT_SECRET=dev-only-member-secret

# 本番ではカンマ区切りの allowlist（例: https://socrates-quiz.jp）。
# 未設定または空のときは開発向けに Origin を反射する。
# CORS_ALLOWED_ORIGINS=

# Seed 同期（sync-production）用
QUIZ_SEED_GENERATOR_SCRIPT=../scripts/generate_migration.py
QUIZ_PYTHON_BIN=python3
QUIZ_MIGRATIONS_DIR=migrations
